{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "compatibilityPolicy": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "enum": ["v1alpha1"]
        },
        "images": {
          "description": "Driver and loader approvals are scoped independently to each OS flavor. Empty pairs deny that flavor; runtime policy validation rejects incomplete configured pairs.",
          "type": "object",
          "required": ["driver", "loader"],
          "additionalProperties": false,
          "properties": {
            "driver": {"$ref": "#/definitions/flavorImages"},
            "loader": {"$ref": "#/definitions/flavorImages"}
          }
        }
      }
    }
  },
  "definitions": {
    "flavorImages": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "jammy": {"$ref": "#/definitions/imagePolicy"},
        "noble": {"$ref": "#/definitions/imagePolicy"},
        "azurelinux3": {"$ref": "#/definitions/imagePolicy"}
      }
    },
    "imagePolicy": {
      "type": "object",
      "required": ["desiredDigest", "approvedDigests"],
      "additionalProperties": false,
      "properties": {
        "desiredDigest": {
          "type": "string",
          "pattern": "^(|sha256:[a-fA-F0-9]{64})$"
        },
        "approvedDigests": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sha256:[a-fA-F0-9]{64}$"
          }
        }
      }
    }
  }
}
